# Allowlist: nothing is published unless it's named here. New files stay private by default.
/*
!/.gitignore
!/README.md
!/LICENSE
!/.github/
!/docs/
/docs/*
!/docs/*.png
!/gc_*.py
!/window.py
!/assets/
/assets/**/*.*
!/assets/**/*.png
!/tests/
/tests/*
!/tests/*.py

!/app/
/app/*
!/app/package.json
!/app/bun.lock
!/app/bunfig.toml
!/app/README.md
!/app/assets_src/
!/app/scripts/
/app/scripts/*
!/app/scripts/*.py
!/app/scripts/*.ps1
!/app/scripts/*.mjs
!/app/src/
/app/src/*
!/app/src/*.js
!/app/src/*.mjs
!/app/src/*.css
!/app/src/*.html
!/app/src/assets/
/app/src/capture-*.mjs
!/app/tests/
/app/tests/*
!/app/tests/*.py

!/app/python/
/app/python/*
!/app/python/*.py
!/app/python/XynLevel-core.spec
!/app/python/requirements.txt

!/app/src-tauri/
/app/src-tauri/*
!/app/src-tauri/Cargo.toml
!/app/src-tauri/Cargo.lock
!/app/src-tauri/build.rs
!/app/src-tauri/tauri.conf.json
!/app/src-tauri/src/
!/app/src-tauri/capabilities/
!/app/src-tauri/icons/
!/app/src-tauri/resources/

!/app/installer/
/app/installer/*
!/app/installer/Cargo.toml
!/app/installer/Cargo.lock
!/app/installer/build.rs
!/app/installer/src/
!/app/installer/app.json
!/app/installer/index.html
!/app/installer/style.css
!/app/installer/ui.js
!/app/installer/prepare.py
!/app/installer/test_prepare.py
!/app/installer/README.md

# Never, even inside allowed folders
__pycache__/
*.pyc
*.log
/app/scripts/publish_check.py
